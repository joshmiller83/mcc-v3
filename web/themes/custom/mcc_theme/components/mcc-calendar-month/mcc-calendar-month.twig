<div{{ attributes.addClass('mcc-calendar', 'mcc-calendar--' ~ density|default('comfortable')) }}>

  <header class="mcc-calendar__bar">
    <div class="mcc-calendar__heading">
      {% if eyebrow %}<p class="mcc-calendar__eyebrow">{{ eyebrow }}</p>{% endif %}
      <h1 class="mcc-calendar__title">{{ month_label }}</h1>
    </div>

    <nav class="mcc-calendar__nav" aria-label="Calendar month navigation">
      <a class="mcc-calendar__round" href="{{ nav.prev_url }}" rel="prev"
         aria-label="Previous month, {{ nav.prev_label }}"><span aria-hidden="true">&lsaquo;</span></a>
      <a class="mcc-calendar__pill{{ nav.is_current_month ? ' is-current' : '' }}" href="{{ nav.today_url }}"
         {{ nav.is_current_month ? 'aria-current="page"' }}>Today</a>
      <a class="mcc-calendar__round" href="{{ nav.next_url }}" rel="next"
         aria-label="Next month, {{ nav.next_label }}"><span aria-hidden="true">&rsaquo;</span></a>

      {% if can_add %}
        <a class="mcc-calendar__pill" href="/node/add/calendar_event" target="_blank" rel="noopener">
          Add event<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      {% endif %}

      <a class="mcc-calendar__print" href="{{ nav.print_url }}">
        {{ icon('lucide', 'printer', { size: 16 }) }}
        Print this month
      </a>
    </nav>
  </header>

  {% if legend is not empty %}
    {{ include('mcc_theme:mcc-calendar-legend', { items: legend, variant: 'screen' }, with_context = false) }}
  {% endif %}

  {# The grid keeps its minimum width and scrolls rather than squeezing cells
     until titles break mid-word. Below the agenda breakpoint it is replaced
     outright — see the stylesheet. #}
  <div class="mcc-calendar__card">
    <div class="mcc-calendar__scroller">
      <div class="mcc-calendar__grid" role="table" aria-label="{{ month_label }}">
        <div class="mcc-calendar__weekdays" role="row">
          {% for weekday in weekdays %}
            <div class="mcc-calendar__weekday" role="columnheader">
              <abbr title="{{ weekday.long }}">{{ weekday.short }}</abbr>
            </div>
          {% endfor %}
        </div>

        {% for week in weeks %}
          {{ include('mcc_theme:mcc-calendar-week', { week: week, can_add: can_add }, with_context = false) }}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="mcc-calendar__agenda">
    {{ include('mcc_theme:mcc-calendar-agenda', {
      days: agenda|default([]),
      month_label: month_label,
      can_add: can_add,
    }, with_context = false) }}
  </div>

  {% if footnote %}
    <p class="mcc-calendar__footnote">{{ footnote }}</p>
  {% endif %}

</div>
