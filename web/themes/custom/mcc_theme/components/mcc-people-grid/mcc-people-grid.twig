{% set level = heading_level|default('h2') %}

<section{{ attributes.addClass('mcc-people-grid') }}
  {%- if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %}>

  {% if heading %}
    <div class="mcc-people-grid__header">
      <div class="mcc-people-grid__headings">
        <{{ level }} class="mcc-people-grid__heading"
          {%- if heading_id %} id="{{ heading_id }}"{% endif %}>{{ heading }}</{{ level }}>
        {% if description %}
          <div class="mcc-people-grid__description">{{ description }}</div>
        {% endif %}
      </div>

      {% if aside %}
        <div class="mcc-people-grid__aside">{{ aside }}</div>
      {% elseif count_label %}
        <p class="mcc-people-grid__count">{{ count_label }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="mcc-people-grid__cards">{{ cards }}</div>
</section>
